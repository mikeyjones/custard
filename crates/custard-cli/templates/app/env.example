# Variables for working on {{name}} on your own machine. Copy this file to .env.
#
# Deployed, The Custard Factory sets all of these itself. While developing,
# take yours from the environment's "My variables" page on The Custard Factory,
# which gives your own database workspace and the sign-in service, or use the
# local ones below.

# The database. `docker compose up -d` starts this one; migrations run as the
# app starts while developing.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/{{name_snake}}_dev
# DIRECT_DATABASE_URL=   (defaults to DATABASE_URL)

# Signing in, with the environment's sign-in service. Its development callback
# is http://localhost:3000/_custard/auth/callback.
# CUSTARD_AUTH_ISSUER=https://auth--<environment host>
# CUSTARD_AUTH_CLIENT_ID=
# CUSTARD_AUTH_CLIENT_SECRET=

# Without the sign-in service, everyone is signed in as this person, with
# these comma-separated roles. Debug builds only.
CUSTARD_DEV_USER=you@example.com
CUSTARD_DEV_ROLES=admin

# File storage: the environment's bucket.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Telemetry is sent only when this is set; logs always go to the terminal.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# RUST_LOG=info
